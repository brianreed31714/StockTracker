
# Alpaca market data feed
# iex = free/Basic Alpaca data
# sip = paid full-market data
ALPACA_DATA_FEED=iex


# Pick a model available to your OpenAI API account.
OPENAI_MODEL=gpt-6-luna

# ------------------------------------------------------------
# 3) STOCK EOD PERFORMANCE — NEW APPLICATION
# Add these to the stock trader's .env
# ------------------------------------------------------------
PUSHOVER_STOCK_EOD_ENABLED=1

# Stock report time is America/New_York because the trader already uses ET.
# 22:30 ET = 19:30 Pacific. Weekday EOD report is due before 20:00 Pacific.
PUSHOVER_STOCK_EOD_HOUR=22
PUSHOVER_STOCK_EOD_MINUTE=30

# Optional custom state-file path. Usually leave unset.
# STOCK_EOD_STATE_PATH=stock_eod_report_state.json


# ============================================================
# Multi-Asset Momentum Trader v1
# ============================================================

# General
CHECK_INTERVAL_SECONDS=60

# Tradable assets
TRADE_SYMBOLS=XOM,WMT,AMZN,AAPL,NVDA,TSLA,NBIS,SPY,QQQ,GLD

# ============================================================
# Position / Portfolio Risk
# ============================================================

MAX_POSITION_DOLLARS=10000
MAX_TRADE_DOLLARS=2500
MAX_TOTAL_EXPOSURE=10000
MAX_OPEN_POSITIONS=4
MAX_TRADES_PER_DAY=12
MAX_DAILY_REALIZED_LOSS=300

# ============================================================
# Buy / Sell Logic
# ============================================================

BUY_SCORE_THRESHOLD=70
SELL_SCORE_THRESHOLD=30

BUY_CONFIRMATIONS=2
SELL_CONFIRMATIONS=2

# ============================================================
# Stops / Profit Protection
# ============================================================

STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.03

TRAILING_STOP_ACTIVATION_PCT=0.01
TRAILING_STOP_PCT=0.0125

# ============================================================
# News / Signal Logic
# ============================================================

NEWS_MIN_MATERIALITY=0.10
NEWS_SHOCK_MATERIALITY=0.55
NEWS_SHOCK_LOOKBACK_HOURS=18

# ============================================================
# VIX Market-Regime Indicator
# ============================================================

# Actual ^VIX is requested first.
# VIXY is used as the fallback proxy if ^VIX is unavailable.
VIX_FALLBACK_SYMBOL=VIXY

# ============================================================
# SHADOW MARKET REGIME RESEARCH — DOES NOT CHANGE ORDERS
# ============================================================
REGIME_SHADOW_ENABLED=1
REGIME_RISK_ON_MIN=70
REGIME_NEUTRAL_MIN=40
REGIME_SPY_200_BUFFER_PCT=0.01
REGIME_QQQ_200_BUFFER_PCT=0.01
REGIME_VIX_MAX_RISK_ON=25
REGIME_TREND_CACHE_SECONDS=900
REGIME_SHADOW_LOG_INTERVAL_SECONDS=300
REGIME_SHADOW_DEFENSIVE_ASSET=SGOV
# ============================================================
# SHADOW XLF / FAS / FAZ RESEARCH — DOES NOT PLACE ORDERS
# ============================================================
FIN_LEVERAGE_SHADOW_ENABLED=1
FIN_LEVERAGE_SNAPSHOT_SECONDS=300
FIN_LEVERAGE_SIGNAL_COOLDOWN_SECONDS=900
FIN_LEVERAGE_MIN_SCORE=70
FIN_LEVERAGE_OUTCOME_HORIZONS=5,15,30,60
# ============================================================
# MARKET-AWARE + PREMARKET INTELLIGENCE
# ============================================================
PREMARKET_ENABLED=1
PREMARKET_START_MINUTES=30
PREMARKET_REFRESH_OFFSETS=30,20,10,5,1
PREMARKET_CONTEXT_MAX_ADJ=5
PREMARKET_CONTEXT_ACTIVE_MINUTES=60
PREMARKET_SOCIAL_SOURCE=UNAVAILABLE
MARKET_OPEN_WARMUP_MINUTES=20
CLOSED_IDLE_MAX_SLEEP_SECONDS=21600
# ============================================================
# AI Strategy Review
# ============================================================

STRATEGY_REVIEW_INTERVAL_MINUTES=60
STRATEGY_REVIEW_LOOKBACK_HOURS=24
STRATEGY_REVIEW_MIN_DECISIONS=30

# ============================================================
# Database / Logging / Dashboard
# ============================================================

MULTI_DB_PATH=momentum_trader.sqlite3
MULTI_LOG_ROOT=momentum_logs
DASHBOARD_STATE_PATH=dashboard_state.json

# ============================================================
# STOCKTRACKER AGENTIC WORKFLOW — NON-SECRET SETTINGS
# ============================================================
DAILY_REVIEW_MODEL=gpt-6-luna
DAILY_REVIEW_MIN_PROPOSAL_SAMPLES=12
DAILY_REVIEW_PUSHOVER_ENABLED=1

STOCKTRACKER_DEPLOYMENT_AGENT_ENABLED=1
STOCKTRACKER_DEPLOYMENT_AGENT_POLL_SECONDS=60

STOCKTRACKER_ACTIVE_TRADER=momentum_trader_v1_9_zpta_shadow.py
STOCKTRACKER_ACTIVE_GEO=xom_geo_feed_v1_1_agentic.py
STOCKTRACKER_ACTIVE_DASHBOARD=momentum_dashboard_v1_3_agentic.py

STOCKTRACKER_SUPERVISOR_CHECK_SECONDS=60
STOCKTRACKER_SUPERVISOR_RESTART_GRACE_SECONDS=20
STOCKTRACKER_SUPERVISOR_BOOT_DELAY_SECONDS=30

# Windows Task Scheduler remains a fallback. The active trader starts the
# pipeline from the Alpaca session calendar at actual close + 5 minutes,
# including early-close sessions.
STOCKTRACKER_DAILY_REVIEW_LOCAL_TIME=13:30
POST_CLOSE_REVIEW_ENABLED=1
POST_CLOSE_REVIEW_DELAY_MINUTES=5
POST_CLOSE_REVIEW_RUNNER=run_daily_model_review.bat
POST_CLOSE_REVIEW_TIMEOUT_SECONDS=1800

# ============================================================
# ZPTA OTC SPECIALIST — INTEGRATED SHADOW RESEARCH ONLY
# ============================================================
ZPTA_SHADOW_ENABLED=1
ZPTA_DATA_PROVIDER=auto
ZPTA_ALLOW_YAHOO_FALLBACK=1
ZPTA_CHECK_SECONDS=60
ZPTA_SHADOW_STARTING_CASH=1000
ZPTA_MAX_POSITION_DOLLARS=150
ZPTA_MAX_POSITION_EQUITY_PCT=0.15
ZPTA_MAX_DAILY_LOSS_PCT=0.03
ZPTA_MAX_TRADES_PER_DAY=6
ZPTA_ENTRY_SCORE=68
ZPTA_EXIT_SCORE=42
ZPTA_MIN_DOLLAR_VOLUME_5M=25000
ZPTA_MAX_SPREAD_PROXY_PCT=0.08
ZPTA_MAX_ENTRY_SLIPPAGE_PCT=0.025
ZPTA_NO_NEW_ENTRIES_AFTER=15:30
ZPTA_FLATTEN_AT=15:45
ZPTA_PUSHOVER_ENABLED=1
ZPTA_DB_PATH=momentum_trader.sqlite3
ZPTA_LOG_ROOT=momentum_logs/zpta
ZPTA_STATE_PATH=zpta_state.json
